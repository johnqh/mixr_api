# =============================================================================
# Mixr API Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# For local overrides, use .env.local (takes priority over .env).
#
# Priority order:
#   1. .env.local (highest - for local development overrides)
#   2. .env (standard environment file)
#   3. System environment variables
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:5432/mixr_db

# -----------------------------------------------------------------------------
# Firebase Admin SDK (Required)
# -----------------------------------------------------------------------------
# Your Firebase project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Service account email from Firebase Console
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Private key from service account JSON (include the full key with newlines)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# LLM Provider (Optional)
# -----------------------------------------------------------------------------
# OpenAI API key. Optional when pointing at a local LM Studio server, where
# any non-empty value works (e.g. "lm-studio").
OPENAI_API_KEY=

# LM Studio / OpenAI-compatible endpoint (e.g. http://localhost:1234/v1)
# Leave empty to use the default OpenAI endpoint.
LLM_STUDIO_ENDPOINT=

# -----------------------------------------------------------------------------
# RevenueCat (Optional)
# -----------------------------------------------------------------------------
# Secret API key used by the subscription middleware to verify entitlements.
# When unset, subscription checks are skipped.
REVENUECAT_API_KEY=

# -----------------------------------------------------------------------------
# Server (Optional)
# -----------------------------------------------------------------------------
# Port to run the server on (default: 6174)
PORT=6174

# Environment mode: development, production, or test
NODE_ENV=development

# Comma-separated list of allowed CORS origins.
# Defaults to '*' in development.
CORS_ORIGINS=
